# Reddit API credentials for a free "script" app.
# Create one at https://www.reddit.com/prefs/apps  (see README / setup steps).
# Then copy this file to ".env" and fill in your real values. ".env" is git-ignored.
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT=SentiFolio/0.1 by u/your_reddit_username
